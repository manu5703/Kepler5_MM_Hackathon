# Copy this file to .env and fill in real values. .env is gitignored.
#
#   cp .env.example .env

# Required for real model calls. Leave MOCK=1 below to run with no key at all.
ANTHROPIC_API_KEY=

# Model tiers under test — see PROTOTYPE_PLAN.md §3 for why these IDs
# (not the ones in the original spec, which name a retired Sonnet version).
DIAGNOSE_MODEL=claude-sonnet-5
GENERATE_MODEL=claude-haiku-4-5
# Optional third tier used only as a quality ceiling in the Lab matrix.
CEILING_MODEL=claude-opus-5

# 1 = serve pre-recorded tool calls from server/mock-data.js, no API calls,
#     no key required. Flip to 0 once ANTHROPIC_API_KEY is set above.
MOCK=1

# "A" = single call does diagnosis + selection + filling (DIAGNOSE_MODEL used).
# "B" = two calls — DIAGNOSE_MODEL diagnoses, GENERATE_MODEL fills the tool.
# See PROTOTYPE_PLAN.md §2 and spec §8.
AGENT_MODE=B

# Enforce strict:true on tool schemas (schema-valid args guaranteed).
# Keep 0 for matrix runs (measures real validation-failure rate);
# fine to set 1 for the portal path once prompts are tuned. See plan §3.2.
STRICT_TOOLS=0

# Express API port. The Vite dev server proxies /api to this port.
PORT=8787
